        544
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json;const w=p.workflow??{};const e=p.execution??{};const t=p.trigger??{};const id=String(w.id??'');const name=String(w.name??'');if(!name.startsWith('EDVORA — '))return [];return [{json:{backend_url:p.backend_url,workflow_id:id,workflow_name:name.slice(0,120),execution_id:e.id===undefined?null:String(e.id),failure_kind:e.error?'execution_error':t.error?'trigger_error':'workflow_error',failed_node:typeof e.lastNodeExecuted==='string'?e.lastNodeExecuted.slice(0,120):null,incident_key:'n8n:'+id+':'+String(e.id??$execution.id),record_only:name.includes('WF05')},pairedItem:{item:0}}];"
      }
    },
