      "id": "5b10fb49-11ee-41f6-a14c-098176ef1d6a",
      "name": "Sticky Note 198a02f4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        672,
        224
      ],
      "parameters": {
        "content": "## Edvora payment verification — inactive, Paystack test only\nBackend /api/automation/payments/claim persists worker ownership leases. /reconcile requires job_id, claim_token and reference, then independently verifies the reference against Paystack using server credentials. Worker-supplied amounts/provider IDs never create a credit.\nDatabase locks and idempotency keep duplicate/concurrent callbacks from double crediting. Receipts and notification jobs commit with the payment. Non-successful, pending, mismatched or unavailable provider responses preserve the balance.\nConfigure backend HTTPS origin, Edvora Backend Service and Paystack test credentials before integration. No live payment collection or messages occurred during this update.",
        "color": 5
      }
    }
