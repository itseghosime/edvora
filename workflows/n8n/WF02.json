    },
    {
      "id": "80aa86ef-918b-4217-aeb9-5b3ceaae7284",
      "name": "Validate Payment Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json; if(!Array.isArray(p.jobs)) throw new Error('Expected payment jobs array'); const seen=new Set(); return p.jobs.map(j=>{if(!j||typeof j.job_id!=='string'||!j.job_id||typeof j.claim_token!=='string'||!j.claim_token||typeof j.reference!=='string'||!j.reference||j.reference.length>200||!Number.isSafeInteger(j.expected_amount_minor)||j.expected_amount_minor<=0||j.currency!=='NGN'||j.environment!=='test'||seen.has(j.job_id))throw new Error('Invalid payment job or unsupported environment');seen.add(j.job_id);return {json:j,pairedItem:{item:0}};});"
      }
    },
    {
      "id": "bd004d03-ebd2-43bb-995f-8f91efe9784d",
      "name": "Verify Reference with Paystack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1024,
        224
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.paystack.co/transaction/verify/\" + encodeURIComponent($json.reference) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "8ab17b24-1ae2-419a-8e51-63892805a56d",
      "name": "Check Amount Currency and Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j=$('One Payment at a Time').item.json; const r=$input.first().json; const b=r.body??{};const d=b.data??{};const validResponse=!r.error&&r.statusCode===200&&b.status===true;const matches=validResponse&&d.reference===j.reference&&d.amount===j.expected_amount_minor&&d.currency===j.currency&&d.domain===j.environment;const terminalFailure=['failed','abandoned','reversed'].includes(d.status); let decision='defer';let reason='verification_unavailable_or_pending';if(validResponse&&!matches){decision='review';reason='provider_details_mismatch';}else if(matches&&d.status==='success'&&d.id!==undefined&&Number.isFinite(Date.parse(d.paid_at??''))){decision='verify_and_credit';reason=null;}else if(matches&&terminalFailure){decision='record_non_success';reason='provider_non_success';}return [{json:{job_id:j.job_id,claim_token:j.claim_token,reference:j.reference,decision,reason,provider_status:typeof d.status==='string'?d.status:null,provider_transaction_id:d.id===undefined?null:String(d.id),amount_minor:Number.isSafeInteger(d.amount)?d.amount:null,currency:typeof d.currency==='string'?d.currency:null,environment:typeof d.domain==='string'?d.domain:null,paid_at:typeof d.paid_at==='string'?d.paid_at:null},pairedItem:{item:0}}];"
      }
    },
    {
