      "id": "23245ae0-8d39-4499-b05d-9878f7f2dc68",
      "name": "Claim Payment Verification Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        496,
        224
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Edvora Configuration\").first().json.backend_url + \"/api/automation/payments/claim\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {run_id:$execution.id,limit:20} }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
