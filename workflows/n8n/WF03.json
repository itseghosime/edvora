        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {...$json,execution_id:$execution.id} }}",
        "options": {
          "timeout": 15000,
