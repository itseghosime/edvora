    {
      "id": "35bd5da2-0e92-4c99-98c3-c84f9bd28b17",
      "name": "Validate Delivery Event IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json;if(!Array.isArray(p.events))throw new Error('Expected delivery events array');const seen=new Set();return p.events.map(e=>{if(!e||typeof e.event_id!=='string'||!e.event_id||typeof e.claim_token!=='string'||!e.claim_token||seen.has(e.event_id))throw new Error('Invalid or duplicate delivery event');seen.add(e.event_id);return {json:e,pairedItem:{item:0}};});"
      }
    },
    {
      "id": "bb9753ff-4c25-422c-8c1e-cf8351b6e2cc",
      "name": "Validate Authenticated Delivery Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$input.first().json;const allowed=['sent','delivered','failed','expired','rejected','unknown'];const ok=e.provider==='termii'&&e.channel==='sms'&&e.source_authenticated===true&&typeof e.provider_message_id==='string'&&!!e.provider_message_id&&allowed.includes(e.status)&&Number.isFinite(Date.parse(e.occurred_at??''));return [{json:{event_id:e.event_id,claim_token:e.claim_token,decision:ok?'apply':'quarantine',provider:'termii',channel:'sms',provider_message_id:typeof e.provider_message_id==='string'?e.provider_message_id:null,status:ok?e.status:'unknown',occurred_at:ok?e.occurred_at:null,reason:ok?null:'invalid_or_untrusted_delivery_event'},pairedItem:{item:0}}];"
      }
    },
    {
      "id": "eacfdd46-01ca-4d03-883e-5b3a8a3c9d85",
      "name": "Apply Delivery Status and Acknowledge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1248,
        224
      ],
