      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Edvora Configuration\").first().json.backend_url + \"/api/automation/notifications/claim\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {run_id:$execution.id,limit:10} }}",
