        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {job_id:$json.job_id,claim_token:$json.claim_token,execution_id:$execution.id} }}",
        "options": {
