    {
      "id": "7026eb95-5dde-4c03-a54b-4add3914af2f",
      "name": "Record Telegram Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2224,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const job = $('Validate Send Authorization').item.json; const r = $input.first().json; const result = r.result ?? r; const id = result.message_id; const sent = !r.error && (r.ok === true || !!result.chat) && id !== undefined; return [{json:{...job,status:sent?'sent':'unknown',provider_message_id:sent?String(id):null,reason:sent?null:'provider_outcome_requires_review'},pairedItem:{item:0}}];"
      }
    },
