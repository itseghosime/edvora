    {
      "id": "9f24692b-f8a9-4f81-b0e5-0f245b7f3e3e",
      "name": "Validate Notification Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json;\nif (!Array.isArray(payload.jobs)) throw new Error('Backend must return {jobs: []}.');\nconst seen = new Set();\nreturn payload.jobs.map((job, index) => {\n if (!job || typeof job.job_id !== 'string' || !job.job_id || typeof job.claim_token !== 'string' || !job.claim_token || seen.has(job.job_id)) throw new Error('Invalid or duplicate claimed job.');\n seen.add(job.job_id);\n return {json:{job_id:job.job_id,claim_token:job.claim_token},pairedItem:{item:0}};\n});"
      }
    },
