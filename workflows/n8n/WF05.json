        "jsonBody": "={{ {to:$json.recipient,from:$(\"Edvora Configuration\").first().json.sms_sender,sms:$json.message,type:\"plain\",channel:\"dnd\"} }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
