    {
      "id": "ca1f4545-6e26-48d3-b97d-2e79ab2c36f1",
      "name": "Sticky Note 8c698132",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1152,
        608
      ],
      "parameters": {
        "content": "## Edvora school notifications — inactive until integration\nEvery 2 minutes; claims at most 10 jobs via /api/automation/notifications/{claim,authorize,outcome}. Same lease/attempt ownership rules as reminders. Receipts and published reports remain eligible at zero fee balance.\nBackend verifies the committed receipt/report and linked guardian permission/consent. Withdrawn reports cancel queued notices. Staff operational alerts use authorized server-only contact records; no invented recipients. Unimplemented/expired invitation sources are denied.\nSMS accepted is not delivered; Telegram sent is not read. Unknown provider results require review, never blind resend. HTTP 429 may be retried with capped backend backoff; outcome writes may safely retry. WF05 failures are record-only to prevent recursive alerts.\nConfigure public HTTPS origin and dedicated Edvora credentials before integration. No WhatsApp or Telegram linking. No messages sent during this update.",
        "color": 5
      }
    }
