      "id": "e1250137-6e9c-476c-9d00-952434320481",
      "name": "Record Skipped Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2224,
        608
      ],
      "parameters": {
