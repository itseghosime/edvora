    {
      "id": "621b0511-325c-4641-b2f2-4fccca4ba02d",
      "name": "Validate Send Authorization",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const original = $('One Reminder at a Time').item.json;\nconst a = $input.first().json;\nconst channel = a.channel;\nconst recipient = String(a.recipient ?? '');\nconst lease = Date.parse(a.lease_expires_at ?? '');\nconst validRecipient = channel === 'telegram' ? /^[1-9][0-9]{0,15}$/.test(recipient) : channel === 'sms' && /^[1-9][0-9]{7,14}$/.test(recipient);\nconst eligible = a.authorized === true && a.job_id === original.job_id && typeof a.attempt_id === 'string' && !!a.attempt_id && typeof a.attempt_token === 'string' && !!a.attempt_token && a.active === true && a.paused === false && a.consented === true && a.currency === 'NGN' && Number.isSafeInteger(a.balance_minor) && a.balance_minor > 0 && Number.isFinite(lease) && lease > Date.now() + 30000 && validRecipient && typeof a.message === 'string' && a.message.trim().length > 0 && a.message.length <= (channel === 'telegram' ? 4000 : 480);\nreturn [{json:{...original,attempt_id:a.attempt_id ?? null,attempt_token:a.attempt_token ?? null,channel,recipient,message:a.message ?? '',eligible,skip_reason:eligible ? null : 'authorization_or_eligibility_check_failed'},pairedItem:{item:0}}];"
      }
    },
