    {
      "id": "1feed03f-b4eb-4018-af56-9003dbf9d17e",
      "name": "Record SMS Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2224,
        416
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const job = $('Validate Send Authorization').item.json;\nconst r = $input.first().json; const b = r.body ?? {}; const status = Number(r.statusCode);\nconst accepted = !r.error && status >= 200 && status < 300 && typeof b.message_id === 'string' && !!b.message_id;\nconst rateLimited = !r.error && status === 429;\nconst rejected = !r.error && status >= 400 && status < 500 && status !== 408 && status !== 429;\nreturn [{json:{...job,status:accepted?'accepted':rateLimited?'failed':rejected?'rejected':'unknown',retryable:rateLimited,provider_message_id:accepted?b.message_id:null,reason:accepted?null:rateLimited?'provider_rate_limit':rejected?'provider_rejected_request':'provider_outcome_requires_review'},pairedItem:{item:0}}];"
      }
    },
