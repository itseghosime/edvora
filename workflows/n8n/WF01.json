        496,
        224
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Edvora Configuration\").first().json.backend_url + \"/api/automation/reminders/claim\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {run_id:$execution.id,limit:10} }}",
        "options": {
