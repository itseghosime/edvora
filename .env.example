# ==============================================================================
# Edvora Nursery & Primary School — Environment Configuration (.env.example)
# DO NOT COMMIT SECRETS TO SOURCE CONTROL
# ==============================================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Automation Service Key (Used by n8n workflows WF01 - WF05)
# Passed as header: "Authorization: Bearer <AUTOMATION_SERVICE_KEY>"
# High-entropy 256-bit token
AUTOMATION_SERVICE_KEY="edv_sec_7f9c2d8e4b1a0f3e5d8c6b4a2e9f1d7c0b3a5e8d2c4f6a9b1e3d5c7f0a2b4e6d"

# 3. Paystack Integration (TEST MODE ONLY - Never use live keys)
# Paystack uses PAYSTACK_SECRET_KEY directly for HMAC-SHA512 webhook signature verification
PAYSTACK_PUBLIC_KEY="pk_test_sample_edvora_public_key"
PAYSTACK_SECRET_KEY="sk_test_sample_edvora_secret_key"

# 4. Termii SMS Gateway
TERMII_API_KEY="termii_sample_api_key"
TERMII_SENDER_ID="EdvoraSch"
TERMII_BASE_URL="https://api.ng.termii.com"
# Termii Delivery Reports (DLR) webhook secret token appended to webhook URL (?secret=...)
TERMII_WEBHOOK_SECRET="edv_termii_sec_9a8b7c6d5e4f3a2b1c0d"

# 5. Telegram Notifications (Dedicated Edvora Bot)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# 6. Supabase Postgres & Auth (Required for production persistence)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
